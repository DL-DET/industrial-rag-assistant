# 阿里云百炼 DashScope API Key
DASHSCOPE_API_KEY=

# 可选配置
CHAT_MODEL_NAME=qwen-max
EMBEDDING_MODEL_NAME=text-embedding-v4
RETRIEVAL_TOP_K=3
MAX_HISTORY_MESSAGES=20
RERANK_ENABLED=true
RERANK_MODEL=qwen3.7-text-rerank
RERANK_TOP_N=3
RERANK_CANDIDATE_K=10
RERANK_TIMEOUT_SECONDS=3
RERANK_FAILURE_THRESHOLD=3
RERANK_COOLDOWN_SECONDS=60
HYBRID_BM25_K=10
HYBRID_RRF_K=60
CHROMA_COLLECTION_NAME=rag
CHROMA_PERSIST_DIRECTORY=chroma_db
CHAT_HISTORY_DIRECTORY=chat_history
QA_LOG_PATH=logs/qa.jsonl
OBSERVABILITY_ENABLED=true
# 拒答路由：重排分低于阈值时跳过生成，阈值只对重排分生效
REFUSAL_ENABLED=true
REFUSAL_SCORE_THRESHOLD=0.75
MD5_STATE_PATH=md5_text
CHUNK_SIZE=300
CHUNK_OVERLAP=50
PARENT_CHUNK_SIZE=800
PARENT_CHUNK_OVERLAP=100
MAX_UPLOAD_SIZE_MB=10
